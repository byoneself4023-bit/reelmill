{
  "audio": "narration.mp3",
  "audio_hash": "20c34dcd896c3ffa",
  "sentences": [
    {
      "no": 1,
      "text": "서울 지하철 1호선은 왼쪽으로 달립니다.",
      "start": 0.05,
      "end": 2.94,
      "after": "쉼 뒤"
    },
    {
      "no": 2,
      "text": "2호선도, 3호선도 오른쪽인데 1호선만 반대입니다.",
      "start": 2.76,
      "end": 6.51,
      "after": "쉼 뒤"
    },
    {
      "no": 3,
      "text": "고장도, 실수도 아닙니다.",
      "start": 6.74,
      "end": 9.08,
      "after": "쉼 뒤"
    },
    {
      "no": 4,
      "text": "우리나라 첫 철도는 1899년, 제물포와 노량진 사이에 놓입니다.",
      "start": 9.1,
      "end": 13.81,
      "after": "쉼 뒤"
    },
    {
      "no": 5,
      "text": "일제강점기를 거치며 철도는 일본식으로 깔립니다.",
      "start": 14.03,
      "end": 17.33,
      "after": "쉼 뒤"
    },
    {
      "no": 6,
      "text": "일본은 영국식으로 철도를 놓았고, 영국 기차는 왼쪽으로 달립니다.",
      "start": 17.54,
      "end": 22.24,
      "after": "쉼 뒤"
    },
    {
      "no": 7,
      "text": "그런데 해방 뒤인 1946년, 미군정이 자동차만 오른쪽으로 바꿉니다.",
      "start": 22.21,
      "end": 27.34,
      "after": "쉼 뒤"
    },
    {
      "no": 8,
      "text": "기차는 왼쪽에 그대로 남습니다.",
      "start": 27.54,
      "end": 29.65,
      "after": "쉼 뒤"
    },
    {
      "no": 9,
      "text": "1974년에 개통한 1호선은 경인선, 경부선 기차와 이어 달려야 했습니다.",
      "start": 29.48,
      "end": 35.24,
      "after": "이어 읽음"
    },
    {
      "no": 10,
      "text": "그러니 1호선도 왼쪽입니다.",
      "start": 35.02,
      "end": 37.25,
      "after": "이어 읽음"
    },
    {
      "no": 11,
      "text": "2호선부터는 오른쪽으로 지었습니다.",
      "start": 36.94,
      "end": 39.62,
      "after": "이어 읽음"
    },
    {
      "no": 12,
      "text": "그럼 1호선도 오른쪽으로 바꾸면 되지 않을까요.",
      "start": 39.96,
      "end": 43.32,
      "after": "쉼 뒤"
    },
    {
      "no": 13,
      "text": "신호 체계부터 안내판까지 전부 뜯어고쳐야 합니다.",
      "start": 43.18,
      "end": 46.55,
      "after": "쉼 뒤"
    },
    {
      "no": 14,
      "text": "그래서 바꾸는 대신, 길을 꼬았습니다.",
      "start": 46.24,
      "end": 49.34,
      "after": "이어 읽음"
    },
    {
      "no": 15,
      "text": "4호선 남태령역과 선바위역 사이.",
      "start": 49.67,
      "end": 52.14,
      "after": "쉼 뒤"
    },
    {
      "no": 16,
      "text": "오른쪽 지하철이 왼쪽 철도로 넘어가는 곳입니다.",
      "start": 52.22,
      "end": 55.08,
      "after": "이어 읽음"
    },
    {
      "no": 17,
      "text": "땅속에서 선로가 X자로 엇갈립니다.",
      "start": 55.26,
      "end": 57.97,
      "after": "이어 읽음"
    },
    {
      "no": 18,
      "text": "이름은 꽈배기굴입니다.",
      "start": 57.76,
      "end": 59.62,
      "after": "이어 읽음"
    },
    {
      "no": 19,
      "text": "1호선이 왼쪽으로 달리는 이유는 1호선에 없습니다.",
      "start": 60.03,
      "end": 62.92,
      "after": "쉼 뒤"
    },
    {
      "no": 20,
      "text": "120년도 더 전에 놓인 첫 선로에 있습니다.",
      "start": 63.14,
      "end": 66.39,
      "after": "이어 읽음"
    }
  ]
}
